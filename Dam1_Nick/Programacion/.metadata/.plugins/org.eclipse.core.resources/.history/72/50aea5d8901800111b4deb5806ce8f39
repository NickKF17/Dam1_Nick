package def;

import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.util.*;

public class Ejercicio6 {

    public static void main(String[] args) {
        Path nombreFichero = Path.of("/home/alumno/Dam_Nick/Dam1_Nick/Programacion/Ficheros/ejercicio6.txt");
        ArrayList<String> lineas = null;
        
        try {
            // Mantenemos el cast que te pide tu profesor
            lineas = (ArrayList<String>) Files.readAllLines(nombreFichero);
            
            // Verificamos que no sea nulo y que tenga contenido
            if (lineas != null && !lineas.isEmpty()) {
                if (sigueFormato(lineas)) {
                    System.out.println("El formato es el correcto");
                } else {
                    System.out.println("No es el formato correcto");
                }
            } else {
                System.out.println("El archivo está vacío o no existe");
            }
            
        } catch (Exception e) {
            System.out.println("Error al leer el archivo");
        }
    }

    public static boolean sigueFormato(ArrayList<String> lineas) {
        boolean formato = true;

        // CRÍTICO: Si el archivo no tiene grupos de 3, ya no sigue el formato
        if (lineas.size() % 3 != 0) {
            formato = false;
        } else {
            // Usamos una sola estructura para evitar returns por todos lados
            for (int i = 0; i < lineas.size() && formato; i = i + 3) {
                
                // Patrón para texto (Nombre y Apellido)
                Pattern patronTexto = Pattern.compile("^[^0-9]+$");
                // Patrón para números (Edad/ID)
                Pattern patronNumero = Pattern.compile("^[0-9]+$");

                // Validar Nombre
                if (!patronTexto.matcher(lineas.get(i)).matches()) {
                    System.out.println("Línea " + i + " debería ser Nombre");
                    formato = false;
                }
                
                // Validar Apellido
                if (formato && !patronTexto.matcher(lineas.get(i + 1)).matches()) {
                    System.out.println("Línea " + (i + 1) + " debería ser Apellido");
                    formato = false;
                }

                // Validar Número
                if (formato && !patronNumero.matcher(lineas.get(i + 2)).matches()) {
                    System.out.println("Línea " + (i + 2) + " debería ser un número");
                    formato = false;
                }
            }
        }
        return formato;
    }
}
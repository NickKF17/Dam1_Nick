package def;

public class Persona {

private String nombre;
private String apellido;
private int edad;

public Persona(String nom,String ape) {
	this.nombre=nom;
	this.apellido=ape;
}

public void incrementaEdad() {
	this.edad++;

}
public void mostrar() {
	System.out.println(this.apellido+", "+this.apellido);
}
}

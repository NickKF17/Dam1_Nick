package def;

import java.util.*;

public class Pregunta {
private String p;
private String r1;
private String r2;
private String r3;
public static ArrayList<Pregunta> preguntas = new ArrayList<>();

	public Pregunta(String p,String r1,String r2,String r3){

		
		this.p=p;
		this.r1=r1;
	this.r2=r2;
	this.r3=r3;
	preguntas.add(this);
	}
	public String getEnunciado() { return p; }
	
	public List<String> getOpcionesMezcladas() {
        ArrayList<String> opciones = new ArrayList<>();
        opciones.add(r1);
        opciones.add(r2);
        opciones.add(r3);
        Collections.shuffle(opciones);
        return opciones;
    }


}

package def;


import java.io.PrintWriter;
import java.util.*;

public class Ejercicio1Writer {

	public static void main(String[] args) {
escribir3();
	}
	public static void escribir3() {
		boolean correcto=true;
		Scanner teclado=new Scanner(System.in);
		System.out.println("¿De que número quieres la tabla?");
		int num=teclado.nextInt();
		teclado.close();
		try{
			if(num<0||num>11){
				System.out.println("Solo se aceptan numeros entre el 1 y el 10");
				 correcto=false;
			}
		}catch(Exception e){
			System.out.println("Eso no es un número entero");
			correcto=false;
		}
		if(correcto==true) {
			String nombreFichero="tabla-"+String.valueOf(num)+".txt";
			try (PrintWriter pluma = new PrintWriter("/home/alumno/Dam_Nick/Dam1_Nick/Programacion/Ficheros/"+nombreFichero)){
				for(int i=1;i<=10;i++){
				int resultado=num*i;
				pluma.printf("%2dx%2d=%2d",num,i,resultado);
				pluma.println();
				}
			}catch(Exception e) {
				pluma.print("Pedazo de bot pon un número entero entre 1 y 10");
				}
			}
		}
}


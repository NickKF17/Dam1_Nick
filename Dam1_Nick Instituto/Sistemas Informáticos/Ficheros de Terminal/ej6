#!/bin/bash

read -p "Introduce la ruta del directorio: " directorio
read -p "Introduce la palabra a buscar en los nombres: " palabra

if [ ! -d "$directorio" ]; then
    echo "Error: El directorio no existe."
else
    for archivo in "$directorio"/*"$palabra"*; do
        if [ -f "$archivo" ]; then
            echo "------------------------------------------"
            echo "Archivo encontrado: $(basename "$archivo")"
            echo "Contenido:"
            cat "$archivo"
            echo "------------------------------------------"
            
            read -p "¿Deseas borrar este archivo? (s/n): " confirmacion
            
            if [[ "$confirmacion" == [sS] ]]; then
                rm "$archivo"
                
                if [ ! -e "$archivo" ]; then
                    echo "El archivo ha sido borrado correctamente."
                else
                    echo "Error: No se ha podido eliminar el archivo."
                fi
            else
                echo "Operación cancelada. El archivo se mantiene."
            fi
        fi
    done
fi
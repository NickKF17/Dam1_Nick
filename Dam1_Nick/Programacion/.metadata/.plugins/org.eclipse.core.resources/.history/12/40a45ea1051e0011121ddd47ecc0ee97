public static void comprobarUsuario(HashMap<String, String> usuarios) {
	Scanner teclado =new Scanner(System.in);	
	
	System.out.println("Introduzca su usuario por favor");
	String usuario =teclado.nextLine();
	System.out.println("Introduzca su contraseña:");
	String contraseña=teclado.nextLine();
	
	if(usuarios.containsKey(usuario)) {
		if(!usuarios.containsValue(contraseña))
			System.out.println("contraseña incorrecta");
	}else
		System.out.println("El usuario no existe");
	
	if(usuarios.containsKey(usuario) && usuarios.containsValue(contraseña))
		System.out.println("Accediendo a su cuenta...");
		
	}
public static HashMap<String,String> leerFichero(String fichero){
HashMap <String,String> usuarios = new HashMap<>();
	
	try {File fiche=new File(fichero);
	Scanner lector =new Scanner(fiche);
	String linea=null;

	while (lector.hasNextLine()){
	linea=lector.nextLine();
	usuarios.put(linea.substring(0, linea.indexOf(":")),linea.substring(linea.indexOf(":")+1));
	
		}
if(linea==null) {
	System.out.println("El fichero esta vacio");
}
	lector.close();
		}catch (Exception e) {
			System.out.println("Error con el fichero");
			System.out.println(e.getMessage());
		}
	
	return usuarios;
}
	

}

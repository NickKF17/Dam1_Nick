		Path nombreFichero = Path.of("/home/alumno/Dam_Nick/Dam1_Nick/Programacion/Ficheros/ejercicio5.txt");
		ArrayList<String> lineas = null;
		try{
			lineas = (ArrayList<String>) Files.readAllLines(nombreFichero);

package def;


import java.io.PrintWriter;
import java.util.*;
public class Ejercicio1Writer {

	public static void main(String[] args) {
escribir3();
	}
	public static void escribir3() {
		try (PrintWriter pluma = new PrintWriter("/home/alumno/Dam_Nick/Dam1_Nick/Programacion/Ficheros/tabla-n.txt")){//con el FileWriter en medio añades en lugar de reemplazar
			Scanner teclado=new Scanner(System.in);
			System.out.println("¿De que número quieres la tabla?");
			int num=teclado.nextInt();
			teclado.close();
			if(num>=1||num<=10) {
			for(int i=1;i<=10;i++){
			int resultado=num*i;
			pluma.printf("%2dx%2d=%2d",num,i,resultado);
			pluma.println();
			}
			}else
				System.out.println("Solo se aceptan numeros entre el 1 y el 10");
			
		}catch(Exception e){
			System.out.println(e.getMessage());
		}
		
	}

}

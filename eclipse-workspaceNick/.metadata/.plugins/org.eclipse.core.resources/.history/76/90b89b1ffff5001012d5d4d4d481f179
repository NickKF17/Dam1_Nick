package def;

public class Ej18 {
public static void main(String[] args) {
	int n= (int)(Math.random()*6);
	    if (n <= 1) return false;    
	    if (n == 2) return true;       // Único par primo
	    if (n % 2 == 0) return false;  // Restricción: ningún otro par
	    
	    // Optimización: solo hasta la raíz cuadrada saltando pares
	    for (int i = 3; i * i <= n; i += 2) {
	        if (n % i == 0) return false;
	    }
	    return true;
	}

}
}

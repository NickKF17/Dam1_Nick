package def;
import java.util.*;
public class CentroMedico {
	private String nombre;
	private String codigo;
	private ArrayList<Medico> medicos= new ArrayList<>();
	private ArrayList<Paciente> pacientes= new ArrayList<>();
	private ArrayList<Consultas> consultas= new ArrayList<>();
public CentroMedico(String nom,String codi){
	this.nombre=nom;
	this.codigo=codi;
}
public void addMedico(Medico medico) {
	medicos.add(medico);
}
public void eliminarMedico(Medico medico) {
	medicos.remove(medico);
}
public void addPaciente(Paciente paciente) {
	pacientes.add(paciente);
}
public void eliminarPaciente(Paciente paciente) {
	pacientes.remove(paciente);
}
public void addconsultas(Consultas c) {
	consultas.add(c);
}
public void eliminarConsultas(Consultas c ){
	consultas.remove(c);
}
public String getNombre() {
	return this.nombre;
}
public void listarPacientes() {
	for(Paciente paci:pacientes) {
		System.out.println(paci.getNombre()+" "+paci.getApellido());
}
	System.out.println("-----------------");
}
public void listarMedicos() {
	for(Medico medi:medicos) {
		System.out.println(medi.getNombre()+" "+medi.getApellido());
}
	System.out.println("-----------------");
}
public void listarConsultas() {
	for(Consultas c:consultas) {
		System.out.println(" Paciente: "+ c.getpaciente() +"\n Medico: "+c.getmedico()+"\n Fecha: " +c.getfecha()+"   "+"Motivo: "+ c.getmotivo());
}
	System.out.println("-----------------");
}


}

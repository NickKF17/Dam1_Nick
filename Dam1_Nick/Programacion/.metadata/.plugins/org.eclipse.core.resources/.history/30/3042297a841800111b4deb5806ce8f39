			double media = sumaAlturas/(contHombre+contMujer);
			System.out.printf("Hombres: %d\n", contHombre);
			System.out.printf("Mujeres: %d\n", contMujer);
			System.out.printf("Estatura media: %.2f\n", contHombre);
			
		}
	}
}
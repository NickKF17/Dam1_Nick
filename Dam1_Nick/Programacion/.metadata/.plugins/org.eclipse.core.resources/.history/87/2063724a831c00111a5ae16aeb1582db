public class Ejercicio2Writer {

	public static void main(String[] args) {
 darLaVuelta("/home/alumno/Dam_Nick/Dam1_Nick/Programacion/Ficheros/origen.txt","/home/alumno/Dam_Nick/Dam1_Nick/Programacion/Ficheros/destino.txt");

	}
	
	public static void darLaVuelta(String origen,String destino) {
		ArrayList<String> listaOrigen=null;
		ArrayList<String> listaDestino =new ArrayList<>();
		
		listaOrigen=leerFichero(origen);
		if(listaOrigen!=null) {
		for(String linea:listaOrigen) {
			linea=invertirContenido(linea);
			
			listaDestino.add(0,linea);
		}
		escribirFichero(destino,listaDestino);
	}
	}

	private static String invertirContenido(String linea) {
	String lineainversa="";
		for(int i=linea.length();i>=0;i--) {
	lineainversa+=linea.charAt(i);
	}
		return lineainversa;
}

	public static ArrayList<String> leerFichero(String origen) {
		
			ArrayList<String> lineas=null;

			Path fichero = Path.of(origen);

			try {
			
			lineas = (ArrayList<String>) Files.readAllLines(fichero);
			
		}catch(Exception e) {
		System.out.println(e.getMessage());
		}
		return lineas;
	}

	public static void escribirFichero(String destino, ArrayList<String> listaDestino) {
	
			Path ruta =Path.of(destino);
			
		
					try {
						Files.write(ruta,listaDestino);
					}catch(Exception e){
						System.out.println("Error: "+e.getMessage());
					}
					
					
		}

	}

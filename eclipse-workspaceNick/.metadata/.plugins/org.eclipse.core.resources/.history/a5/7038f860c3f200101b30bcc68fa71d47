package def;

import java.util.ArrayList;

public abstract class Persona {
protected String nombre;
protected String apellidos;
public Persona(String nom,String ape) {
	this.nombre=nom;
	this.apellidos=ape;
}
public String getNombre() {
	return this.nombre;
}
public String getApellido() {
	return this.apellidos;
}

public void addconsultas(Consultas c) {
	consultasmedi.add(c);
}
public void eliminarConsultas(Consultas c ){
	consultasmedi.remove(c);
}
}
class Medico extends Persona{
	private String especialidad;
	private int numeroCole;/*6 numeros*/
	private CentroMedico centromed;
	private ArrayList<Consultas> consultasmedi= new ArrayList<>();
	public Medico(String nom,String ape,String espe,int numCole,CentroMedico centro ) {
		super(nom,ape);
		this.especialidad=espe;
		this.numeroCole=numCole;
		this.centromed=centro;
	centromed.addMedico(this);
	
	}
	public void cambiocentro(CentroMedico centro) {
		this.centromed.eliminarMedico(this);
		this.centromed=centro;
		this.centromed.addMedico(this);
	}
}


